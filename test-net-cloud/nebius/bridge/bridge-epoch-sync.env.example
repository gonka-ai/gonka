# Copy to /srv/dai/bridge-epoch-sync.env (or bridge-epoch-sync.env next to the script)
# and chmod 600. Do not commit the real file.
#
# cp bridge-epoch-sync.env.example /srv/dai/bridge-epoch-sync.env

# Ethereum bridge owner key (must match BridgeContract.owner())
PRIVATE_KEY=0xYOUR_ETH_PRIVATE_KEY

# Sepolia bridge contract
BRIDGE_ADDRESS=0xYOUR_BRIDGE_CONTRACT

# Gonka API base URL (no trailing slash)
GONKA_API=http://localhost:8000

# Sepolia JSON-RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Paths (required when script lives at /srv/dai/bridge-epoch-sync.sh, not inside the repo)
BRIDGE_DIR=/srv/dai/gonka/proposals/ethereum-bridge-contact
ENABLE_SCRIPT=/srv/dai/gonka/test-net-cloud/nebius/bridge/bridge-enable-normal-op.js

# How often the daemon loop polls (seconds)
POLL_SECONDS=30

# Log full bridge-enable-normal-op.js output every poll (0=off, 1=on)
VERBOSE=0

# When caught up, log a heartbeat every N polls (1 = every poll)
HEARTBEAT_EVERY=1

# Optional overrides (defaults are derived from this script's location in the repo)
# BRIDGE_CONTRACT_DIR=/srv/dai/gonka/proposals/ethereum-bridge-contact
# BRIDGE_DIR=/srv/dai/gonka/proposals/ethereum-bridge-contact
# LOG_FILE=/var/log/bridge-epoch-sync.log
