                ]
              }
            ]
          }
        },
        "policyExtraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(OTEL_[A-Z0-9_]+|DEVSHARD_OTEL_ENABLED|EDGE_API_OTEL_ENABLED)$"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
