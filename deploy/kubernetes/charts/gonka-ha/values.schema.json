{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z][a-z0-9-]{0,38}[a-z0-9]$",
      "maxLength": 40
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versiond": {
          "type": "string"
        },
        "router": {
          "type": "string"
        },
        "proxyRouter": {
          "type": "string"
        },
        "proxyPolicy": {
          "type": "string"
        },
        "edgeApi": {
          "type": "string"
        },
        "oracle": {
          "type": "string"
        }
      }
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}$"
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oracleUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$"
        },
        "dapiHost": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]+$"
        },
        "dapiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "chainRpcUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$"
        },
        "chainGrpcUrl": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]+:[0-9]+$"
        },
        "chainGrpcTls": {
          "type": "boolean"
        },
        "nodeManagerAddress": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]+:[0-9]+$"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyName": {
          "type": "string"
        },
        "accountPubKey": {
          "type": "string"
        },
        "keyringSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "disable",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "caSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "poolMaxConns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireDistinctNodes": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "versiond": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1201
        },
        "hostShutdownBudgetSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "drainAnnounceSeconds": {
          "type": "integer",
          "minimum": 5
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(OTEL_[A-Z0-9_]+|DEVSHARD_OTEL_ENABLED|EDGE_API_OTEL_ENABLED)$"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "valueFrom"
                ]
              }
            ]
          }
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1201
        },
        "versionCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "activationMinReady": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(OTEL_[A-Z0-9_]+|DEVSHARD_OTEL_ENABLED|EDGE_API_OTEL_ENABLED)$"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "valueFrom"
                ]
              }
            ]
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
