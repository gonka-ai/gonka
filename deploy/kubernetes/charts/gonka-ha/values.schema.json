              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "valueFrom"
                ]
              }
            ]
          }
        }
      }
    },
    "edgeApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(OTEL_[A-Z0-9_]+|DEVSHARD_OTEL_ENABLED|EDGE_API_OTEL_ENABLED)$"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
