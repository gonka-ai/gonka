# Binary Singularity — MEDIUM stack environment
# Without Gonka keys → mock-node fallback (fully reproducible).
# With keys → live Gonka inference via opengnk proxy.

# ── Ports ──
EMBED_PORT=8686
MOCK_NODE_PORT=8082
OPENGNK_PORT=8080
QM_PORT=9090

# ── Gonka credentials (for opengnk proxy, optional) ──
# Get from: ./inferenced create-client + keys export
GONKA_PRIVATE_KEY=
GONKA_ADDRESS=
# Or multi-wallet: GONKA_WALLETS=privkey1:addr1,privkey2:addr2
GONKA_WALLETS=

# Find nodes: https://gonka.gg/nodes
GONKA_SOURCE_URL=http://YOUR_GONKA_NODE:8000
SIMULATE_TOOL_CALLS=false

# ── Quality middleware upstream ──
# http://mock-node:8082   → reproducible (no keys needed)
# http://opengnk:8080     → live Gonka inference (needs keys + --profile live)
QM_UPSTREAM=http://mock-node:8082

# ── Hub approval ──
HUB_URL=https://gonka.gg/api/public/stats/historical
HUB_KEY=

# ── Experiment ──
ITERATIONS=12
MODELS=mock
EPOCH_DURATION_SECS=600

# ── Raw binary input (Exp 4 replay) ──
BS_RAW_INPUT=
BS_CHUNK_LINES=50

# ── Semantic pool search precision ──
# 7500 = 0.75 cosine similarity floor. Aggressive noise rejection.
BS_MIN_SIM_BPS=7500
