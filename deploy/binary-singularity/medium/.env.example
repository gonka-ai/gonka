# Binary Singularity — MEDIUM stack environment
# Requires Gonka keys for live inference via opengnk.
# Without keys, mock-node is used as fallback.

# ── Ports ──
EMBED_PORT=8686
MOCK_NODE_PORT=8082
OPENGNK_PORT=8080
QM_PORT=9090

# ── Gonka credentials (for opengnk proxy) ──
# Get from: ./inferenced create-client + keys export
GONKA_PRIVATE_KEY=
GONKA_ADDRESS=
# Or multi-wallet: GONKA_WALLETS=privkey1:addr1,privkey2:addr2
GONKA_WALLETS=

GONKA_SOURCE_URL=http://node2.gonka.ai:8000
SIMULATE_TOOL_CALLS=false

# ── Quality middleware ──
# Set to opengnk for live Gonka inference, mock-node for reproducible tests
QM_UPSTREAM=http://mock-node:8082

# ── Hub approval ──
HUB_URL=https://gonka.gg/api/public/stats/historical
HUB_KEY=

# ── Experiment ──
ITERATIONS=12
MODELS=mock
EPOCH_DURATION_SECS=600
