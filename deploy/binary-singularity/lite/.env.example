# Binary Singularity — LITE stack environment
# Copy to .env and edit. All variables have safe defaults.

# ── Network ──
EMBED_PORT=8686
MOCK_NODE_PORT=8082

# ── Hub approval (leave HUB_KEY empty to skip) ──
HUB_URL=https://gonka.gg/api/public/stats/historical
HUB_KEY=
HUB_THRESHOLD=0.95

# ── Experiment scale ──
ITERATIONS=12
MODELS=mock

# ── Raw binary input (Exp 4 replay) ──
# Set BS_RAW_INPUT to an absolute path to feed raw data into the binarizer.
# The file is transmitted as-is to the embedder — no pre-processing.
# Example: BS_RAW_INPUT=/home/user/data/text
BS_RAW_INPUT=
BS_CHUNK_LINES=50

# ── Slot search ──
# Minimum cosine similarity (basis points) to accept a pool match.
# 7500 = 0.75 cosine. Raise to reduce noise; lower for broader recall.
BS_MIN_SIM_BPS=7500
