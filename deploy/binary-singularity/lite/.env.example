# Binary Singularity — LITE stack environment
# Copy to .env and fill in HUB_KEY if you want hub approval check.

EMBED_PORT=8686
MOCK_NODE_PORT=8082

# Hub approval (optional — leave empty to skip)
HUB_URL=https://gonka.gg/api/public/stats/historical
HUB_KEY=

# Experiment scale
ITERATIONS=12
MODELS=mock

# Convergence threshold for hub check
HUB_THRESHOLD=0.95
