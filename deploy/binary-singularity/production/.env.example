# Binary Singularity — PRODUCTION stack
# This runs on a real Gonka node alongside deploy/join/ infrastructure.
# GNK tokens are consumed for live inference.

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED: Gonka credentials
# ──────────────────────────────────────────────────────────────────────────────
# Option A: single wallet
# Get key: ./inferenced keys export <name> --unarmored-hex --unsafe
# Get address: ./inferenced keys show <name> -a
GONKA_PRIVATE_KEY=<YOUR_HEX_PRIVATE_KEY>
GONKA_ADDRESS=<YOUR_GONKA1_ADDRESS>

# Option B: multi-wallet (for higher throughput, round-robin)
# GONKA_WALLETS=privkey1:gonka1addr1,privkey2:gonka1addr2

# ──────────────────────────────────────────────────────────────────────────────
# Node discovery
# ──────────────────────────────────────────────────────────────────────────────
# Public network node or your own. Find nodes at: https://gonka.gg/nodes
GONKA_SOURCE_URL=http://YOUR_GONKA_NODE:8000
SIMULATE_TOOL_CALLS=false

# ──────────────────────────────────────────────────────────────────────────────
# API keys (for hub approval + stats)
# ──────────────────────────────────────────────────────────────────────────────
# Public stats key (read-only, for hub approval check)
# Get from: https://gonka.gg → API Keys
GONKA_API_KEY=<YOUR_GNK_LIVE_KEY>
HUB_URL=https://gonka.gg/api/public/stats/historical
HUB_KEY=<YOUR_GNK_LIVE_KEY>

# ──────────────────────────────────────────────────────────────────────────────
# Ports (adjust if conflicts with existing node stack)
# ──────────────────────────────────────────────────────────────────────────────
EMBED_PORT=8686
OPENGNK_PORT=8080
QM_PORT=9090

# ──────────────────────────────────────────────────────────────────────────────
# Quality middleware upstream
# ──────────────────────────────────────────────────────────────────────────────
# Production: route through opengnk (live Gonka inference with GNK)
QM_UPSTREAM=http://opengnk:8080
EPOCH_DURATION_SECS=600

# ──────────────────────────────────────────────────────────────────────────────
# Raw binary input — feed ANY data source into the binarizer
# ──────────────────────────────────────────────────────────────────────────────
# Set BS_RAW_INPUT to the absolute path of ANY file:
#   - Git repo dumps, commit logs, diffs
#   - Developer workflow logs (Discord, IDE sessions)
#   - Custom markup, documentation, specs
#   - Downloaded files from any source
#   - Binary data, structured or unstructured
#
# The file is transmitted AS-IS to the cluster embedder — zero pre-processing.
# The embedder splits by lines, embeds each chunk, distills PatternSlots.
#
# BS_RAW_INPUT_DIR must be the parent directory (for Docker volume mount).
#
# Examples:
#   BS_RAW_INPUT=/home/user/data/workflow.txt
#   BS_RAW_INPUT_DIR=/home/user/data
#   BS_RAW_INPUT=/home/user/repos/project/.git/logs/HEAD
#   BS_RAW_INPUT_DIR=/home/user/repos/project/.git/logs
#   BS_RAW_INPUT=/tmp/downloaded_spec.md
#   BS_RAW_INPUT_DIR=/tmp
BS_RAW_INPUT=
BS_RAW_INPUT_DIR=
BS_CHUNK_LINES=50

# ──────────────────────────────────────────────────────────────────────────────
# Semantic pool search precision
# ──────────────────────────────────────────────────────────────────────────────
# Minimum cosine similarity (basis points 0-10000) for pool match.
# 7500 = 0.75 cosine. Aggressive noise rejection on CPU.
# Higher = more precise but fewer results. Lower = broader recall.
BS_MIN_SIM_BPS=7500

# ──────────────────────────────────────────────────────────────────────────────
# Slot distillation mode
# ──────────────────────────────────────────────────────────────────────────────
# In production, the runtime operates in CONTINUOUS mode:
#   - Listens to live inference traffic via quality-middleware
#   - Distills successful responses into PatternSlots automatically
#   - No iterations, no scenario matrix — real traffic drives slot creation
#
# BS_DISTILL_MODE controls behavior:
#   continuous  — default: watch traffic, distill on quality threshold
#   ingest      — one-shot: ingest BS_RAW_INPUT, create slots, exit
#   both        — ingest raw input first, then switch to continuous
BS_DISTILL_MODE=continuous

# Minimum quality score (0-1) a response must reach before it becomes a slot.
# 0.70 = only proven-good responses are binarized.
BS_DISTILL_QUALITY_THRESHOLD=0.70
