# Binary Singularity — HARD stack environment (K3s mesh)
# All variables controllable from here — no CLI flags required.
# Copy to .env and edit.

# ── Cluster ──
# CLUSTER_NAME=bs-mesh  # set in run.sh

# ── Hub approval ──
HUB_URL=https://gonka.gg/api/public/stats/historical
HUB_KEY=

# ── Experiment scale ──
ITERATIONS=12
MODELS=mock
# For full 3072-run scale: ITERATIONS=36

# ── Raw binary input (Exp 4 replay) ──
# Set to absolute path of file to feed raw into binarizer unchanged.
# Example: BS_RAW_INPUT=/home/user/data/workflow.txt
BS_RAW_INPUT=
BS_CHUNK_LINES=50

# ── Semantic pool precision ──
# Minimum cosine similarity (0–10000 bps) for pool search results.
# 7500 ≈ 0.75 cosine. Below this = noise, rejected by CPU search.
# Raise to 8500+ for strict matching; lower to 6000 for broader recall.
BS_MIN_SIM_BPS=7500
