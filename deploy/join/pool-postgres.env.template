# Reference connection for update-devshard.sh --check-storage.
# Obtain these settings from the existing pool's known working PostgreSQL
# connection, independently of the versiond replica you are checking.
# Use shell assignments (as in config.env); quote passwords containing spaces
# or shell characters. Save as pool-postgres.env and chmod 600 that file.
PGHOST=
PGPORT=5432
PGDATABASE=devshardd
PGUSER=devshardd
PGPASSWORD=

# Match the pool's TLS settings. Certificate paths are on the host running
# this check, where the PostgreSQL client (psql) is installed.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/absolute/path/to/root.crt
# PGSSLCERT=/absolute/path/to/client.crt
# PGSSLKEY=/absolute/path/to/client.key
