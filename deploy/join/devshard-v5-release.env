# Machine-readable host update contract for the devshard v5 deployment line.
# Keep values shell-safe: this file is sourced by release tooling.
DEVSHARD_V5_RELEASE_ID=0.2.15-devshard-v5
DEVSHARD_V5_RELEASE_GIT_TAG=release/v0.2.15-devshard-v5
DEVSHARD_V5_RELEASE_IMAGE_TAG=0.2.15-devshard-v5
DEVSHARD_V5_EDGE_API_IMAGE=ghcr.io/product-science/edge-api:0.2.15-devshard-v5
DEVSHARD_V5_VERSIOND_IMAGE=ghcr.io/product-science/versiond:0.2.15-devshard-v5
DEVSHARD_V5_EDGE_API_ROUTER_IMAGE=ghcr.io/product-science/edge-api-router:0.2.15-devshard-v5
DEVSHARD_V5_VERSIOND_ROUTER_IMAGE=ghcr.io/product-science/versiond-router:0.2.15-devshard-v5
DEVSHARD_V5_PROXY_POLICY_IMAGE=ghcr.io/product-science/proxy:0.2.15-devshard-v5
DEVSHARD_V5_PROXY_ROUTER_IMAGE=ghcr.io/product-science/proxy-router:0.2.15-devshard-v5

# docker compose features used by the updater include JSON config output,
# service health waits, and project-directory selection.
DEVSHARD_V5_MIN_COMPOSE_VERSION=2.20.0

# These are the published Host Quickstart recommendations, not incremental
# requirements introduced by v5. The updater reports deviations by default;
# --strict-capacity turns them into a release preflight failure.
DEVSHARD_V5_RECOMMENDED_CPUS=16
DEVSHARD_V5_RECOMMENDED_MEMORY_MIB=65536
# A marketed 1 TB device is approximately 931 GiB as reported by df.
DEVSHARD_V5_RECOMMENDED_DISK_GIB=931
