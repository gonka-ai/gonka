      "id": 1,
      "options": {
        "content": "Gateway-owned outside-view metrics for protocol developers. Use this dashboard to inspect user outcomes, hidden participant failures, overscheduling, quarantine pressure, and timeout work. It intentionally uses Prometheus metrics only; no request ledger or functional database queries are required.",
        "mode": "markdown"
      },
      "title": "How to Read This",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
