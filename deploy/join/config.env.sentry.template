# config.env for the sentry stack. Copy to config.env.sentry, fill in,
# `source` before running `docker compose -f docker-compose.sentry.yml up -d`.

# === Required ===

# Chain identity (must match validator's CHAIN_ID).
export CHAIN_ID=
export IS_TEST_NET=false

# Public seeds — sentry uses these for genesis download and statesync.
# Same values the validator uses.
export SEED_NODE_RPC_URL=
export SEED_NODE_P2P_URL=
export RPC_SERVER_URL_1=
export RPC_SERVER_URL_2=

# Default fallback for any sentry's advertised P2P address.
# Override per-sentry below if each has a distinct public address.
export P2P_EXTERNAL_ADDRESS=

# === Sentry 1 (always brought up) ===

export SENTRY_KEY_NAME=sentry
export SENTRY_P2P_PORT=5001
# Public address sentry-1 advertises (defaults to ${P2P_EXTERNAL_ADDRESS}):
# export SENTRY_P2P_EXTERNAL_ADDRESS=tcp://<host>:<port>

# === Sentry 2/3 (only when running --profile multi on this host) ===

# export SENTRY2_KEY_NAME=sentry-2
# export SENTRY2_P2P_PORT=5002
# export SENTRY2_P2P_EXTERNAL_ADDRESS=tcp://<host>:<port>

# export SENTRY3_KEY_NAME=sentry-3
# export SENTRY3_P2P_PORT=5003
# export SENTRY3_P2P_EXTERNAL_ADDRESS=tcp://<host>:<port>

# === Optional shared tuning ===

# export SYNC_WITH_SNAPSHOTS=true
# export SNAPSHOT_INTERVAL=1000
# export SNAPSHOT_KEEP_RECENT=5
# export TRUSTED_BLOCK_PERIOD=2000
# export SENTRY_MAX_INBOUND=100
# export SENTRY_MAX_OUTBOUND=50

# === Mesh — fill in after phase 2 (collect node-ids) ===
#
# Asymmetric mesh:
#   - Each sentry's PERSISTENT_PEERS lists OTHER sentries only (by
#     `<node-id>@<public-host>:<p2p-port>`). The validator is NOT in
#     persistent_peers — after isolation its port is closed and dials
#     would loop-fail.
#   - Each sentry's UNCONDITIONAL_PEER_IDS lists VALIDATOR_ID + every
#     other sentry id, so the inbound connection from the validator
#     (which it initiates) is always accepted, and inbound from peer
#     sentries bypasses peer-count limits.
#   - private_peer_ids=VALIDATOR_ID on every sentry shields validator's
#     node-id from public PEX gossip.
#
# Example with 3 sentries on hosts A/B/C:
#   SENTRY_PERSISTENT_PEERS=SID2@HOSTB:5001,SID3@HOSTC:5001
#   SENTRY_UNCONDITIONAL_PEER_IDS=VID,SID2,SID3
#   SENTRY2_PERSISTENT_PEERS=SID1@HOSTA:5001,SID3@HOSTC:5001
#   SENTRY2_UNCONDITIONAL_PEER_IDS=VID,SID1,SID3
#   SENTRY3_PERSISTENT_PEERS=SID1@HOSTA:5001,SID2@HOSTB:5001
#   SENTRY3_UNCONDITIONAL_PEER_IDS=VID,SID1,SID2

# export VALIDATOR_ID=

# export SENTRY_PERSISTENT_PEERS=
# export SENTRY_UNCONDITIONAL_PEER_IDS=

# export SENTRY2_PERSISTENT_PEERS=
# export SENTRY2_UNCONDITIONAL_PEER_IDS=

# export SENTRY3_PERSISTENT_PEERS=
# export SENTRY3_UNCONDITIONAL_PEER_IDS=
