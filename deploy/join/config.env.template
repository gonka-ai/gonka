# === Optional: sentry mesh (validator-side) ===
#
# Used only when the operator brings up a sentry stack and wants to
# isolate the validator (P2P-only) behind it. See README.md and
# docker-compose.sentry-isolate.yml for the full flow.
#
# After all sentries are running and you've collected their node-ids:
#   docker exec node    inferenced tendermint show-node-id   -> VALIDATOR_ID
#   docker exec sentry  inferenced tendermint show-node-id   -> SENTRY_NODE_ID
#
# Fill the validator's persistent peer list — every sentry by
# `<node-id>@<public-host>:<p2p-port>`:
#
# export NODE_PERSISTENT_PEERS=<sentry-id>@<host>:<port>,...
# export NODE_UNCONDITIONAL_PEER_IDS=<sentry-id>,...
# export NODE_MAX_INBOUND=3          # match sentry count
# export NODE_MAX_OUTBOUND=3

# Optional pruning / state tuning for the validator (app.toml). Defaults
# match a "fast pruning, small state" profile — enough recovery blocks
# kept, fastnode ON. Override here only if you need different behaviour.
# export NODE_PRUNING=custom
# export NODE_PRUNING_KEEP_RECENT=100
# export NODE_PRUNING_INTERVAL=1500
# export NODE_MIN_RETAIN_BLOCKS=0
# export NODE_IAVL_DISABLE_FASTNODE=false

