export KEY_NAME=<FILLIN>
export KEYRING_PASSWORD=<FILLIN>
export API_PORT=8000
export API_SSL_PORT=8443
export PUBLIC_URL=http://<HOST>:<PORT>
export P2P_EXTERNAL_ADDRESS=tcp://<HOST>:<PORT>
export ACCOUNT_PUBKEY=<ACCOUNT_PUBKEY_FROM_STEP_ABOVE>
export NODE_CONFIG=./node-config.json
export HF_HOME=/mnt/shared
export SEED_API_URL=http://node2.gonka.ai:8000
export SEED_NODE_RPC_URL=http://node2.gonka.ai:8000/chain-rpc/
export SEED_NODE_P2P_URL=tcp://node2.gonka.ai:5000
export BEACON_STATE_URL=https://mainnet.checkpoint.sigp.io/
export DAPI_API__POC_CALLBACK_URL=http://api:9100
export DAPI_CHAIN_NODE__URL=http://node:26657
export DAPI_CHAIN_NODE__P2P_URL=http://node:26656
export RPC_SERVER_URL_1=http://node1.gonka.ai:8000/chain-rpc/
export RPC_SERVER_URL_2=http://node2.gonka.ai:8000/chain-rpc/
export PORT=8080
export INFERENCE_PORT=5050
export KEYRING_BACKEND=file

# edge-api becomes unready before it stops accepting requests, then drains
# requests already in flight. The Docker grace is the outer backstop.
export EDGE_API_DRAIN_ANNOUNCE=5s
export EDGE_API_SHUTDOWN_BUDGET=2m
export EDGE_API_STOP_GRACE_PERIOD=3m
export EDGE_API_HEALTH_START_PERIOD=2m

# Version-aware routing. The static list is a startup floor; additions are
# learned from the same governance catalog consumed by versiond.
export VERSIOND_LEGACY_HOST=versiond
export VERSIOND_NON_HA_VERSIONS="v1 v2 v3"
export VERSIOND_VERSIONS="v4 v5 v6 v7 v8"
export VERSIOND_ROUTING_CATALOG_POLL_SECONDS=5
export VERSIOND_ROUTING_CATALOG_FETCH_TIMEOUT_SECONDS=3
export VERSIOND_ROUTING_ACTIVATION_MIN_READY=2
export VERSIOND_ROUTER_VERSION_CAPACITY=32
export PROXY_ROUTER_VERSION_CAPACITY=32

# Public HAProxy and the private nginx policy-worker network.
export PROXY_POLICY_FRONT_NETWORK=gonka-proxy-policy-front
export PROXY_ROUTER_PUBLIC_IDLE_SECONDS=86400

# Observability (docs/observability/observability-overview.md)
# Jaeger and Grafana UIs are disabled by default. Set credentials below first,
# then set JAEGER_ENABLED=true and/or GRAFANA_ENABLED=true to expose them via proxy.
export JAEGER_ENABLED=false
export GRAFANA_ENABLED=false
export JAEGER_BASIC_AUTH_USER=jaeger
export JAEGER_BASIC_AUTH_PASSWORD=<FILLIN>
export GRAFANA_ADMIN_USER=admin
export GRAFANA_ADMIN_PASSWORD=<FILLIN>
export DAPI_OTEL_ENABLED=true
export DEVSHARD_OTEL_ENABLED=true
export OTEL_ENDPOINT=http://jaeger:4317
# CometBFT Prometheus metrics on node:26660 (gonka-node scrape job)
export NODE_INSTRUMENTATION_PROMETHEUS=true

# Transaction fee gas price.
# Note: temporary due to issue in gas estimations.
export DAPI_CHAIN_NODE__MIN_GAS_PRICE_NGONKA=0

# Query gas limit (protects from expensive read queries)
export QUERY_GAS_LIMIT=10000000

# PostgreSQL payload storage (optional, falls back to file storage if not set)
# export POSTGRES_HOST=postgres
# export POSTGRES_PORT=5432
# export POSTGRES_DB=payloads
# export POSTGRES_USER=payloads
# export POSTGRES_PASSWORD=<FILLIN>

# Devshard HA Postgres (docker-compose.versiond.yml → devshard-postgres).
# Required when using the versiond overlay; distinct from payloads POSTGRES_* above.
# export DEVSHARD_POSTGRES_DB=devshardd
# export DEVSHARD_POSTGRES_USER=devshardd
# export DEVSHARD_POSTGRES_PASSWORD=<FILLIN>

# PostgreSQL tuning (optional)
# export POSTGRES_MIN_WAL_SIZE=4GB
# export POSTGRES_MAX_WAL_SIZE=16GB
# export POSTGRES_CHECKPOINT_TIMEOUT=15min
