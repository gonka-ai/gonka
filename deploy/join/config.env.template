export KEY_NAME=<FILLIN>
export KEYRING_PASSWORD=<FILLIN>
export API_PORT=8000
export API_SSL_PORT=8443
export PUBLIC_URL=http://<HOST>:<PORT>
export P2P_EXTERNAL_ADDRESS=tcp://<HOST>:<PORT>
export ACCOUNT_PUBKEY=<ACCOUNT_PUBKEY_FROM_STEP_ABOVE>
export NODE_CONFIG=./node-config.json
export HF_HOME=/mnt/shared
export SEED_API_URL=http://node2.gonka.ai:8000
export SEED_NODE_RPC_URL=http://node2.gonka.ai:8000/chain-rpc/
export SEED_NODE_P2P_URL=tcp://node2.gonka.ai:5000
export BEACON_STATE_URL=https://mainnet.checkpoint.sigp.io/
export DAPI_API__POC_CALLBACK_URL=http://api:9100
export DAPI_CHAIN_NODE__URL=http://node:26657
export DAPI_CHAIN_NODE__P2P_URL=http://node:26656
export RPC_SERVER_URL_1=http://node1.gonka.ai:8000/chain-rpc/
export RPC_SERVER_URL_2=http://node2.gonka.ai:8000/chain-rpc/
export PORT=8080
export INFERENCE_PORT=5050
export KEYRING_BACKEND=file

# versiond reports unready before it starts draining, then uses one absolute
# budget for child drain, process stop, and HTTP shutdown. Docker's grace is the
# outer SIGKILL reserve and must remain larger than the internal budget.
export VERSIOND_DRAIN_ANNOUNCE=5s
export VERSIOND_HOST_SHUTDOWN_BUDGET=25m
export VERSIOND_STOP_GRACE_PERIOD=30m
# A fresh host can spend most of this period downloading approved artifacts;
# a passing /readyz check still marks it healthy immediately.
export VERSIOND_HEALTH_START_PERIOD=30m

# Version-aware routing. The static list is a startup floor; additions are
# learned from the same governance catalog consumed by versiond.
export VERSIOND_LEGACY_HOST=versiond
export VERSIOND_NON_HA_VERSIONS="v1 v2 v3"
export VERSIOND_VERSIONS="v4 v5"
export VERSIOND_ROUTING_CATALOG_POLL_SECONDS=5
export VERSIOND_ROUTING_CATALOG_FETCH_TIMEOUT_SECONDS=3
export VERSIOND_ROUTING_ACTIVATION_MIN_READY=2
export VERSIOND_ROUTER_VERSION_CAPACITY=32
export PROXY_ROUTER_VERSION_CAPACITY=32
# Require the same ready reserve at the public distributor as the fleet keeps
# available during a rolling replacement.
export PROXY_ROUTER_ACTIVATION_MIN_READY=2

# Public HAProxy and the private nginx policy-worker network.
export PROXY_POLICY_FRONT_NETWORK=gonka-proxy-policy-front
# Space-separated CIDRs of external L4 load balancers that send PROXY protocol.
# Leave empty when clients connect directly to this host.
export PROXY_ROUTER_PROXY_PROTOCOL_FROM=
# Docker SIGKILL backstop for draining nginx policy-worker connections.
export PROXY_POLICY_STOP_GRACE_PERIOD=30m
export PROXY_ROUTER_PUBLIC_IDLE_SECONDS=86400

# Independent versiond-router slots. The fleet CLI owns these containers and
# rolls them one at a time while preserving the ready reserve.
export VERSIOND_ROUTER_FLEET_ID=gonka-versiond-router
export VERSIOND_ROUTER_FLEET_SLOTS="0 1 2"
export VERSIOND_ROUTER_MIN_READY=2
export VERSIOND_ROUTER_DRAIN_TIMEOUT_SECONDS=1800
export VERSIOND_ROUTER_START_TIMEOUT_SECONDS=60
export VERSIOND_ROUTER_PULL_POLICY=always
export VERSIOND_ROUTER_FRONT_NETWORK=gonka-versiond-router-front
export VERSIOND_ROUTER_BACK_NETWORK=gonka-versiond-router-back
export VERSIOND_ROUTER_ALLOW_MAINTENANCE_OUTAGE=false
# Explicit versiond pool membership for hosts on other machines. By default the
# routers discover the pool through the versiond-pool DNS alias. To list members
# by address instead, point this at a JSON array of {"id","host","port"} entries
# (a relative path is resolved from this file's directory) and run
# `./versiond-router-fleet.sh apply` after every edit. The file wins over DNS.
# export VERSIOND_POOL_ENDPOINTS_FILE=./versiond-endpoints.json

# Observability (docs/observability/observability-overview.md)
# Jaeger and Grafana UIs are disabled by default. Set credentials below first,
# then set JAEGER_ENABLED=true and/or GRAFANA_ENABLED=true to expose them via proxy.
export JAEGER_ENABLED=false
export GRAFANA_ENABLED=false
export JAEGER_BASIC_AUTH_USER=jaeger
export JAEGER_BASIC_AUTH_PASSWORD=<FILLIN>
export GRAFANA_ADMIN_USER=admin
export GRAFANA_ADMIN_PASSWORD=<FILLIN>
export DAPI_OTEL_ENABLED=true
export DEVSHARD_OTEL_ENABLED=true
export OTEL_ENDPOINT=http://jaeger:4317
# CometBFT Prometheus metrics on node:26660 (gonka-node scrape job)
export NODE_INSTRUMENTATION_PROMETHEUS=true

# Transaction fee gas price.
# Note: temporary due to issue in gas estimations.
export DAPI_CHAIN_NODE__MIN_GAS_PRICE_NGONKA=0

# Query gas limit (protects from expensive read queries)
export QUERY_GAS_LIMIT=10000000

# PostgreSQL payload storage (optional, falls back to file storage if not set)
# export POSTGRES_HOST=postgres
# export POSTGRES_PORT=5432
# export POSTGRES_DB=payloads
# export POSTGRES_USER=payloads
# export POSTGRES_PASSWORD=<FILLIN>

# Devshard HA Postgres (docker-compose.versiond.yml → devshard-postgres).
# Required when using the versiond overlay; distinct from payloads POSTGRES_* above.
# export DEVSHARD_POSTGRES_DB=devshardd
# export DEVSHARD_POSTGRES_USER=devshardd
# export DEVSHARD_POSTGRES_PASSWORD=<FILLIN>
# Persistent bind target for PGDATA. On the first replacement, the entrypoint
# copies an existing v4 anonymous volume here without modifying its rollback copy.
# export DEVSHARD_POSTGRES_DATA_DIR=./devshards/postgres
# For confirmed first-time HA enablement only, pass this override inline to the
# first `docker compose up` command; do not persist it in config.env:
# DEVSHARD_POSTGRES_ALLOW_EMPTY_INIT=true docker compose <same -f options> up -d devshard-postgres
# Never use the override to recover a missing anonymous volume.
# export DEVSHARD_POSTGRES_STOP_GRACE_PERIOD=5m
# export DEVSHARD_POSTGRES_START_PERIOD=30m

# Versiond router policy for docker-compose.versiond.yml. Keep pre-HA versions
# on their single SQLite owner and route HA-capable versions through independent
# readiness pools. Explicit empty values are preserved by the Compose overlay.
export VERSIOND_NON_HA_VERSIONS="v1 v2 v3"
export VERSIOND_VERSIONS="v4 v5"
# Coarse host-level readiness is less precise and is disabled by default.
export VERSIOND_ROUTER_ALLOW_COARSE_READINESS=false
# Catalog routing is activated by a release only after its router image has
# been published. Release automation sets these two values together.
# export VERSIOND_ROUTER_IMAGE=ghcr.io/product-science/versiond-router@sha256:<DIGEST>
# export VERSIOND_ROUTING_CATALOG_URL=http://api:9100/versions
# Keep false during normal operation. Set true only for a supervised maintenance
# run that intentionally removes accepted dynamic routes.
export VERSIOND_ROUTING_CATALOG_ALLOW_REMOVALS=false

# PostgreSQL tuning (optional)
# export POSTGRES_MIN_WAL_SIZE=4GB
# export POSTGRES_MAX_WAL_SIZE=16GB
# export POSTGRES_CHECKPOINT_TIMEOUT=15min
