# Round-robin reverse-proxy in front of N edge-api instances (stateless
# read-only Tier A queries).
#
# Pool membership comes from DNS (EDGE_API_POOL_HOST resolves to every replica)
# and health from active /readyz checks. edge-api reports unready when it cannot
# reach the chain, so an instance that is up but cut off leaves the rotation
# without being restarted, and rejoins on its own. It also reports unready for
# EDGE_API_DRAIN_ANNOUNCE before it stops accepting, so a planned stop leaves the
# rotation before it stops serving.

global
    log stdout format raw local0 info
    stats socket /var/run/haproxy/haproxy.sock mode 660 level admin
    stats timeout 30s

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    # Append the client address to X-Forwarded-For, as the nginx router did.
    option  forwardfor
    timeout connect ${CONNECT_TIMEOUT_SECONDS}s
    timeout client  ${READ_TIMEOUT_SECONDS}s
    timeout server  ${READ_TIMEOUT_SECONDS}s
    timeout http-request ${CONNECT_TIMEOUT_SECONDS}s
    timeout http-keep-alive 10s
    # Without `timeout check`, `inter` doubles as the entire check budget. Must
    # exceed edge-api's own chain-probe budget (readinessTimeout, 2s): a chain
    # answering in 1-2s is slow, not down, and every edge-api shares that chain
    # node — a 1s budget would evict the whole pool over a slow moment.
    timeout check 3s

resolvers docker
    nameserver dns 127.0.0.11:53
    # A 64-slot pool can produce a DNS answer larger than the 512-byte default.
    accepted_payload_size 8192
    resolve_retries 3
    timeout resolve 1s
    timeout retry   1s
    hold valid 5s
    hold other 5s
    hold refused 5s
    hold nx 5s
    hold timeout 5s

frontend edge_api_in
    bind :${EDGE_API_ROUTER_PORT}
    maxconn ${MAX_CONNECTIONS}
    http-request set-header X-Forwarded-Proto %[ssl_fc,iif(https,http)]
    # Overwritten, never trusted from the client: it names the immediate peer.
    http-request set-header X-Real-IP %[src]
    default_backend edge_api_pool

backend edge_api_pool
    balance roundrobin

    option httpchk
    http-check send meth GET uri /readyz
    http-check expect status 200

    http-reuse safe
    option redispatch
    retry-on conn-failure empty-response 502
    retries 2
    # Tier A is read-only, but keep the same rule as versiond-router so the two
    # configs cannot drift on the one property that costs money if it does.
    http-request disable-l7-retry if !METH_GET !METH_HEAD !METH_OPTIONS

    http-response set-header X-Upstream-Addr %[bc_dst]:%[bc_dst_port]

    # init-state fully-down: an instance joins only once a check has passed, not
    # the moment DNS mentions it.
    server-template edgeapi ${POOL_SLOTS} ${EDGE_API_POOL_HOST}:${EDGE_API_PORT} check inter 1s fall 1 rise 2 resolvers docker init-addr none init-state fully-down

frontend metrics
    bind 127.0.0.1:8405
    http-request use-service prometheus-exporter if { path /metrics }
    http-request deny
