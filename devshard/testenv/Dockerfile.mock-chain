# Phase 2: build image for the mock-chain gRPC service.
#
# Replaced with a real multi-stage build once cmd/mockchain compiles.
# For now this just prevents `docker compose build` from aborting in
# phase-0 smoke tests.
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY . /src
RUN go build -o /out/mockchain ./devshard/testenv/cmd/mockchain

FROM alpine:3.20
COPY --from=build /out/mockchain /usr/local/bin/mockchain
ENTRYPOINT ["/usr/local/bin/mockchain"]
