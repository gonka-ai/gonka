# Production-shape mock-chain image (Phase 4 gencompose stub).
# Build context: repo root (../.. from testenv/).
FROM golang:1.25.9-alpine3.23 AS build
RUN apk add --no-cache git ca-certificates
COPY common/ /src/common
COPY inference-chain/ /src/inference-chain
WORKDIR /src/devshard
COPY devshard/go.mod devshard/go.sum ./
ENV GOPROXY=https://proxy.golang.org,direct
RUN --mount=type=cache,id=devshard-go-mod,target=/go/pkg/mod \
    sh -c 'n=0; until go mod download; do n=$((n+1)); [ "$n" -ge 8 ] && exit 1; echo "go mod download retry $n"; sleep $((n*8)); done'
COPY devshard/ .
RUN --mount=type=cache,id=devshard-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=devshard-go-build,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /mockchain ./testenv/cmd/mockchain

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget
COPY --from=build /mockchain /usr/local/bin/mockchain
WORKDIR /app
ENTRYPOINT ["mockchain"]
