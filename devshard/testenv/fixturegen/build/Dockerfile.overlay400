# Variant mlnode-4.0.0 (vLLM 0.30.0 + fork 8219a3e2e) on CPU: the stock 0.30.0 CPU build with the
# fork's .py files overlaid the way the fork's docker/Dockerfile.gonka-poc does it.
ARG BASE_IMAGE=vllm/vllm-openai-cpu:v0.30.0-x86_64
FROM ${BASE_IMAGE}
ARG EXPECTED_VLLM_VERSION=0.30.0
ARG FORK_SHA=unknown
LABEL fixturegen.fork-ref="release/v0.30-decode-int" fixturegen.fork-sha="${FORK_SHA}"
# `fork` is the gonka-ai/vllm checkout at FORK_SHA (docker-bake.hcl).
COPY --from=fork vllm /tmp/vllm-src
RUN INSTALLED=$(python3 -c "import vllm; print(vllm.__version__)") \
    && case "$INSTALLED" in "${EXPECTED_VLLM_VERSION}"*) ;; \
         *) echo "ERROR: base image ships vllm $INSTALLED, residual targets ${EXPECTED_VLLM_VERSION}"; exit 1 ;; \
       esac \
    && VLLM_DIR=$(python3 -c "import vllm, os; print(os.path.dirname(vllm.__file__))") \
    && [ -d "$VLLM_DIR" ] || (echo "ERROR: vllm not importable"; exit 1) \
    && cd /tmp/vllm-src \
    && find . -name "*.py" | tar -cf - -T - | tar -xf - -C "$VLLM_DIR/" \
    && rm -rf /tmp/vllm-src

# In this fork line the API app builder imports gonka_poc (PoC gate and routes), so the render
# server needs the plugin; same pin and extra packages as the fork's recipe at this commit.
ARG GONKA_POC_REPO=gonka-ai/gonka-vllm-plugins
ARG GONKA_POC_REF=v0.2.0
LABEL fixturegen.gonka-poc-ref="${GONKA_POC_REF}"
RUN pip install --no-cache-dir --no-deps \
      "gonka-poc @ https://github.com/${GONKA_POC_REPO}/archive/refs/tags/${GONKA_POC_REF}.tar.gz" \
    && pip install --no-cache-dir "aiohttp>=3.9" "scipy>=1.10"
