#!/bin/sh

# Persistent, validated cache for the router's version-name projection.
# HAProxy maps are process-local; this snapshot lets a replacement process
# render the last known-good routes before the catalog endpoint is reachable.
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1090,SC1091
. "$script_dir/version-contract"

fail() {
    echo "catalog-cache: $*" >&2
    exit 1
}

validate_names() {
    names=$1
    duplicate=$(router_first_duplicate "$names")
    [ -z "$duplicate" ] || fail "snapshot declares version '$duplicate' more than once"
    while IFS= read -r version; do
        router_version_is_valid "$version" || \
            fail "snapshot contains unroutable version '$version'"
    done < "$names"
}

read_cache() {
    cache=$1 max_age=$2
    case "$max_age" in
        '' | *[!0-9]* | 0) fail "MAX_AGE_SECONDS must be a positive integer" ;;
    esac
    [ -f "$cache" ] || exit 1

    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    now=$(date +%s)
    if ! jq -er --argjson now "$now" --argjson max_age "$max_age" '
        select(.schema == 1)
        | select((.fetched_at_unix | type) == "number")
        | select(.fetched_at_unix >= 0 and (.fetched_at_unix | floor) == .fetched_at_unix)
        | select(.fetched_at_unix <= 9007199254740991)
        | select((.versions | type) == "array")
        | (if .fetched_at_unix > $now or ($now - .fetched_at_unix) > $max_age
           then "stale" else "fresh" end),
          (.versions[] | select(type == "string"))
    ' "$cache" > "$tmp"; then
        fail "invalid snapshot $cache"
    fi
    expected=$(jq -er '.versions | length' "$cache") || fail "invalid snapshot $cache"
    actual=$(( $(wc -l < "$tmp") - 1 ))
    [ "$actual" -eq "$expected" ] || fail "snapshot contains a non-string version name"

    freshness=$(sed -n '1p' "$tmp")
    sed '1d' "$tmp" > "$tmp.names"
    trap 'rm -f "$tmp" "$tmp.names"' EXIT
    validate_names "$tmp.names"
    LC_ALL=C sort -u "$tmp.names"
    if [ "$freshness" != fresh ]; then
        echo "catalog-cache: snapshot is stale (maximum age ${max_age}s)" >&2
        rm -f "$tmp" "$tmp.names"
        trap - EXIT
        exit 2
    fi
    rm -f "$tmp" "$tmp.names"
    trap - EXIT
}

write_cache() {
    names=$1 cache=$2
    [ -f "$names" ] || fail "names file does not exist: $names"
    validate_names "$names"
    directory=$(dirname -- "$cache")
    [ -d "$directory" ] || fail "cache directory does not exist: $directory"
    tmp=$(mktemp "$directory/.catalog-cache.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    now=$(date +%s)
    if ! jq -Rn --argjson now "$now" '
        [inputs] | sort | unique
        | {schema: 1, fetched_at_unix: $now, versions: .}
    ' < "$names" > "$tmp"; then
        fail "cannot encode snapshot"
    fi
    chmod 600 "$tmp"
    sync "$tmp"
    mv -f "$tmp" "$cache"
    sync "$directory"
    trap - EXIT
}

case ${1:-} in
    read)
        [ "$#" -eq 3 ] || fail "usage: catalog-cache read FILE MAX_AGE_SECONDS"
        read_cache "$2" "$3"
        ;;
    write)
        [ "$#" -eq 3 ] || fail "usage: catalog-cache write NAMES_FILE CACHE_FILE"
        write_cache "$2" "$3"
        ;;
    *) fail "usage: catalog-cache read FILE MAX_AGE_SECONDS | write NAMES_FILE CACHE_FILE" ;;
esac
