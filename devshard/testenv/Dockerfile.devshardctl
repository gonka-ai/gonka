# syntax=docker/dockerfile:1.7
#
# Phase 11: multi-stage build for devshardctl (developer CLI proxy).
#
# devshardctl is shipped from devshard/cmd/devshardctl — the same
# binary used in production. The testenv compose file runs this service
# as part of the default stack (`docker compose up`).
#
# Build context (set by gencompose) is the devshard module root.

FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build \
        -tags=dev \
        -trimpath -ldflags="-s -w" \
        -o /out/devshardctl \
        ./cmd/devshardctl

FROM gcr.io/distroless/static-debian12:latest
COPY --from=build /out/devshardctl /usr/local/bin/devshardctl

ENTRYPOINT ["/usr/local/bin/devshardctl"]
