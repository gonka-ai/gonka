export DEVSHARD_CHAIN_ID=gonka-mainnet
export DEVSHARD_CHAIN_RPC=http://node:26657
export DEVSHARD_CHAIN_GRPC=node:9090
export DEVSHARD_PUBLIC_API=http://api:9000

export DEVSHARD_INSTANCE_NAME=devshard-gateway
export DEVSHARD_PORT=8080
export GATEWAY_HOST_PORT=18080
export DEVSHARD_STORAGE_DIR=/root/.devshard-gateway
export DEVSHARD_STORAGE_HOST_DIR=.devshard-gateway
export DEVSHARD_SESSION_RETENTION_EPOCHS=2

export DEVSHARD_PRIVATE_KEY=**
export DEVSHARD_API_KEYS=sk-**
export DEVSHARD_ADMIN_API_KEY=sk-admin-**

export DEVSHARD_POC_REQUEST_MODE=relaxed
export GATEWAY_MAX_CONCURRENT_REQUESTS=2048
export GATEWAY_ADMISSION_QUEUE_WAIT_MS=300000
export GATEWAY_ADMISSION_QUEUE_PER_SLOT=4
export GATEWAY_MATCH_WAIT_MS=2000
export GATEWAY_MAX_CONSECUTIVE_BURNS=2
export GATEWAY_DEFAULT_MAX_TOKENS=4096
export GATEWAY_MAX_TOKENS_CAP=4096
export GATEWAY_MAX_BUFFERED_RESPONSE_BYTES=536870912
export DEVSHARDS_JSON=''

export DEVSHARD_TX_GAS_LIMIT=700000

export DEVSHARD_STATS_ENABLED=false
export DEVSHARD_STATS_HOST_PORT=19091
export DEVSHARD_STATS_PORT=9091
export DEVSHARD_STATS_RETENTION_EPOCHS=2
export DEVSHARD_STATS_SNAPSHOT_SECONDS=60

# json (the default when empty) or text; the Loki panels read JSON.
export DEVSHARD_LOG_FORMAT=json

# Sample lock contention and blocking for /debug/pprof/mutex and /block; leave off outside a diagnosis.
export DEVSHARD_ENABLE_CONTENTION_PROFILES=false

export DEVSHARD_ESCROW_ROTATION_ENABLED=true
export DEVSHARD_ESCROW_ROTATION_SETTLEMENT_ENABLED=false
export DEVSHARD_ESCROW_ROTATION_PREVIOUS_EPOCH_SETTLEMENT_ENABLED=true
export DEVSHARD_ESCROW_ROTATION_MODELS_JSON=''

# How stale the chain snapshot may be before requests are refused; 0 disables the gate.
export GATEWAY_CHAIN_SNAPSHOT_MAX_AGE_SECONDS=60

# How often each candidate host's /v1/versions is polled; hosts allow 10 requests a minute per IP on that route.
export GATEWAY_CHAIN_VERSIONS_POLL_INTERVAL_SECONDS=15

# Engine timings. All six also take an admin override, so a change needs no restart.
export GATEWAY_ENGINE_RECEIPT_TIMEOUT_MS=5000
export GATEWAY_ENGINE_FIRST_TOKEN_FLOOR_MS=6000
export GATEWAY_ENGINE_FIRST_TOKEN_CEILING_MS=30000
export GATEWAY_ENGINE_INTER_CHUNK_STALL_MS=30000
export GATEWAY_ENGINE_LOSER_GRACE_MS=600000
export GATEWAY_ENGINE_HEDGE_FIRST_TOKEN_FLOOR_MS=1500

# Quiet escrows compose no height-sync heartbeat; a finished request's leftovers settle either way. true/1/on turns it back on.
export DEVSHARD_HEIGHTSYNC_HEARTBEAT=false

# Empty: every host keeps its own logprobs optimization default (on). true/false forces it for every inference; the admin override logprobs_optimization wins.
export GATEWAY_LOGPROBS_OPTIMIZATION_OVERRIDE=

# OpenTelemetry tracing: one gateway.request span per chat, joined to the hosts' spans. Off is a no-op tracer.
export DEVSHARD_OTEL_ENABLED=false
export OTEL_ENDPOINT=
export OTEL_HEADERS=
