# syntax=docker/dockerfile:1.4

FROM golang:1.24.2-alpine3.20 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,id=go-mod-cache-devshard-mock-chain,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,id=go-build-cache-devshard-mock-chain,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /mock-chain ./cmd/mock-chain

FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl && \
    rm -rf /var/cache/apk/*

COPY --from=builder /mock-chain /usr/bin/mock-chain

EXPOSE 8090

HEALTHCHECK --interval=10s --timeout=3s --retries=6 --start-period=3s \
    CMD curl -f http://localhost:${MOCK_CHAIN_PORT:-8090}/health || exit 1

ENTRYPOINT ["mock-chain"]
