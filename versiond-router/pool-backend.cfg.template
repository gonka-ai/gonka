# One sticky backend rendered once per readiness question the router can ask:
#
#   versiond_ha_pool  — "are you able to serve?", the host-level fallback for a
#                       version the router has not been told about
#   versiond_pool_<v> / versiond_dynamic_<n> — "are you able to serve <v>?",
#                            one per bootstrap or governance version
#   versiond_legacy_<v> — the same per-version question, asked of the one host
#                         that owns this pinned version's SQLite data
#
# Every rendering shares this file, so the routing policy — hashing, retries,
# header handling — cannot drift between them.
#
# HA renderings use the same DNS pool with different checks. Legacy renderings
# use one slot pointed at the explicit SQLite owner. A host missing one version
# therefore stops receiving that version without hiding the versions it serves.

backend ${BACKEND_NAME}
    balance hash var(txn.hashkey)
    hash-type consistent

    # The admin frontend selects this backend through the live version map, then
    # asks it to report the result of the same two-step active check that gates
    # data traffic. Returning here preserves the pre-v5 /<version>/healthz
    # fallback without forwarding /readyz to a supervisor that does not have it.
    http-request return status 200 content-type text/plain string "ready\n" if { var(txn.router_admin_ready) -m found } { nbsrv(${BACKEND_NAME}) gt 0 }
    http-request return status 503 content-type text/plain string "not ready\n" if { var(txn.router_admin_ready) -m found }

    option httpchk
    # v5 readiness is authoritative: 503 removes a starting or draining host.
    # A 404 identifies a pre-v5 versiond, whose route health is the only
    # readiness contract available during rollback and mixed-version cutover.
    # The second request is required in both cases, so accepting 404 never
    # admits a legacy process that cannot actually serve this backend.
    http-check connect
    ${READY_CHECK_SEND}
    http-check expect status 200,404
    http-check connect
    ${ROUTE_CHECK_SEND}
    http-check expect status 200

    # safe never reuses a pooled connection for a request that could not be
    # replayed if the reuse failed. never/aggressive would reopen the window
    # where a POST is written into a connection the peer is already closing.
    http-reuse safe

    # Keep the first connection retry on the consistent-hash owner. If it still
    # cannot connect, the final retry may use another healthy server.
    option redispatch
    ${RETRY_ON}
    retries 2
    # Mirrors nginx's absent non_idempotent: connection-level redispatch for
    # everything, request replay only for idempotent methods.
    http-request disable-l7-retry if !METH_GET !METH_HEAD !METH_OPTIONS

    # Strip the optional /devshard/ prefix before forwarding.
    http-request replace-path ^/devshard/(.*)$ /\1

    ${REQUEST_HA_HEADER}

    http-response set-header X-Upstream-Addr %[bc_dst]:%[bc_dst_port]
    http-response set-header X-Versiond-Backend ${RESPONSE_BACKEND}

    # hash-key addr is what makes this ring stable. By default a server's
    # position is its numeric slot id, and DNS hands the answers to
    # server-template in whatever order it likes — so a router restart could
    # reshuffle which host sits where and re-home every session at once. Keying
    # on the address makes the ring depend on who is in the pool, not on the
    # order they were discovered in.
    # init-state fully-down: a freshly resolved address is not assumed healthy.
    # Without it a host entering DNS is selectable before its first check has
    # run, which is a window straight onto a versiond that is still starting.
    #
    # The entrypoint renders either one server-template over the DNS pool name
    # or one explicit `server` line per entry of VERSIOND_POOL_ENDPOINTS_FILE.
    # Both forms carry the same check, init-state and hash-key options.
${POOL_SERVERS}
