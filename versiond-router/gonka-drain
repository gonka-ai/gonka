#!/bin/sh
# gonka-drain — show what the router currently believes about the pool.
#
# Read-only on purpose. There used to be `out` and `in` here, applying HAProxy's
# forced DRAIN to a server. HAProxy identifies a server by its slot in a
# server-template, and a slot is reused: when a drained host leaves DNS and an
# unrelated one arrives, the new host lands in that slot and inherits the drain.
# It is then quietly kept out of rotation with nothing to show why. Admin state
# belongs to the identity of a process, and the router has no such identity —
# only an address that DNS lent it.
#
# To take a host out of rotation, stop its versiond:
#
#   docker compose stop versiond2
#
# That is graceful by construction — versiond reports unready for
# VERSIOND_DRAIN_ANNOUNCE while it keeps serving, so the router removes it before
# it stops accepting — and it is tied to the process, so nothing can inherit it.
set -eu

SOCK="${HAPROXY_SOCKET:-/var/run/haproxy.sock}"
NON_HA_MAP="${VERSIOND_ROUTER_NON_HA_MAP:-/etc/haproxy/non_ha.map}"

runtime() {
    printf '%s\n' "$1" | socat stdio "$SOCK"
}

# Backends that can actually receive a request. versiond_legacy exists even when
# no version is pinned to it, and then it can be reached by nothing. The map is
# read from HAProxy rather than from disk, because `add map` at runtime is a
# supported way to pin a version and never touches the file.
legacy_is_reachable() {
    [ -n "$(runtime "show map $NON_HA_MAP" | grep -v '^#' | grep -v '^$' || true)" ]
}

backends() {
    runtime "show backend" | grep -v '^#' | grep -v '^$' | while read -r backend; do
        if [ "$backend" = versiond_legacy ] && ! legacy_is_reachable; then
            continue
        fi
        printf '%s\n' "$backend"
    done
}

# `show servers state` columns: 4 = srv_name, 5 = srv_addr, 6 = srv_op_state
# (2 means UP), 7 = srv_admin_state. Slots a DNS answer has never filled carry no
# address and are skipped.
servers() {
    runtime "show servers state $1" | awk 'NR > 2 && NF > 7 && $5 != "-"'
}

serving_count() {
    servers "$1" | awk '$6 == 2 && $7 == 0 { n++ } END { print n + 0 }'
}

case "${1:-}" in
status | "")
    for backend in $(backends); do
        printf '%s\n' "$backend"
        servers "$backend" | awk '{
            if ($7 != 0)      state = "DRAIN"
            else if ($6 == 2) state = "UP"
            else              state = "DOWN"
            print "  " $4 "\t" $5 "\t" state
        }'
        printf '  %s server(s) taking traffic\n' "$(serving_count "$backend")"
    done
    ;;
out | in)
    echo "gonka-drain: '$1' was removed: HAProxy server slots are reused, so a" >&2
    echo "  drain outlives the host it was meant for and is inherited by whichever" >&2
    echo "  host DNS puts in that slot next. Stop the versiond instead:" >&2
    echo "    docker compose stop <service>" >&2
    exit 2
    ;;
*)
    echo "usage: gonka-drain status" >&2
    exit 2
    ;;
esac
