# Sticky router for N versiond instances.
#
# Two upstream pools (rendered by entrypoint.sh):
#   versiond_ha_pool  — consistent-hash on session/escrow id; all VERSIOND_HOSTS
#   versiond_legacy   — single host (VERSIOND_LEGACY_HOST) where SQLite session
#                       DBs for pre-HA (VERSIOND_NON_HA_VERSIONS) versions live
#
# Version path → backend selection:
#   1) map $uri → $devshard_version (first path segment, optional /devshard/ prefix)
#   2) map $devshard_version → $versiond_backend (default HA; NON_HA list → legacy)
#
# Multi-host HA requests also get proxy_set_header Devshard-Ha (see
# $devshard_ha_header). See VERSIOND_NON_HA_VERSIONS / VERSIOND_LEGACY_HOST in
# entrypoint.sh.

upstream versiond_ha_pool {
    # Required by the `resolve` flag below — nginx re-resolves upstream
    # hostnames every TTL (Docker DNS @ 127.0.0.11) so a container restart
    # with a new IP doesn't pin nginx to a stale address until reload.
    zone versiond_ha_pool 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    hash $sticky_key consistent;
${HA_UPSTREAM_SERVERS}
}

upstream versiond_legacy {
    zone versiond_legacy 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
${LEGACY_UPSTREAM_SERVERS}
}

# Strip optional /devshard/ prefix and capture the version name segment.
map $uri $devshard_version {
    default "";
    ~^/(?:devshard/)?(?<ver>[^/]+)(?:/|$) $ver;
}

# Default: HA pool. VERSIOND_NON_HA_VERSIONS entries pin to versiond_legacy.
map $devshard_version $versiond_backend {
${VERSIOND_BACKEND_MAP}
}

# "true" only when multi-VERSIOND_HOSTS and request uses versiond_ha_pool.
# Empty value makes nginx omit the header (devshardd treats absence as non-HA).
map $versiond_backend $devshard_ha_header {
${DEVSHARD_HA_HEADER_MAP}
}

server {
    listen 8080;

    # Extract escrowID from /<version>/sessions/<id>/... (or /devshard/<version>/...
    # when genesis-proxy is not in front, e.g. testenv citest).
    set $sticky_key $request_uri;
    if ($request_uri ~ "^/(?:devshard/)?[^/]+/sessions/([^/]+)") {
        set $sticky_key $1;
    }

    location / {
        rewrite ^/devshard/(.*)$ /$1 break;
        # Variable proxy_pass keeps HA vs legacy selection from the map above.
        proxy_pass http://$versiond_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Devshard-Ha $devshard_ha_header;

        # Streaming-friendly: SSE responses from chat/completions need
        # immediate flushing and no request buffering.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;

        # Inference can be slow.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 30s;

        # Lets citest (and operators) see which versiond upstream handled the request.
        add_header X-Upstream-Addr $upstream_addr always;
        add_header X-Versiond-Backend $versiond_backend always;
    }
}
