# Sticky router for N versiond instances.
#
# Backends:
#   versiond_pool_<v> — one per version in VERSIOND_VERSIONS. Membership is the
#                      whole pool; health is "can you serve <v>", asked of each
#                      host. A host missing one version leaves that version's
#                      ring and keeps serving the rest.
#   versiond_ha_pool — the same pool asked the coarse "can you serve at all",
#                      used for versions the router has not been told about
#   versiond_legacy  — the single VERSIOND_LEGACY_HOST that owns pre-HA SQLite
#                      session data for the versions listed in non_ha.map
#
# Pool membership comes from DNS, health comes from active checks. Neither
# requires a reload: adding a replica publishes another A record, and a draining
# host fails /readyz. There is no router-side state to keep in sync.
#
# Failover: retry on connect failure, empty response, or upstream 502. Never on
# 503 — that is the drain and HA-storage-guard answer, and retrying it would hit
# the same condition on the next host. L7 retries are disabled for
# non-idempotent methods so an inference is never executed twice.

global
    log stdout format raw local0 info
    # Admin socket only; no TCP bind, so it cannot be published by accident.
    stats socket /var/run/haproxy/haproxy.sock mode 660 level admin
    stats timeout 30s

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect ${CONNECT_TIMEOUT_SECONDS}s
    timeout client  ${STREAM_IDLE_SECONDS}s
    timeout server  ${STREAM_IDLE_SECONDS}s
    # Inference streams are long-lived; tunnel governs an established stream and
    # is deliberately generous. The outer Gonka API proxy owns the client-facing
    # limit — the innermost hop must not be the one that cuts a stream, because
    # it has the least context to report a useful error.
    timeout tunnel  ${TUNNEL_TIMEOUT_SECONDS}s
    timeout http-request ${CONNECT_TIMEOUT_SECONDS}s
    timeout http-keep-alive 10s
    # Without `timeout check`, `inter` doubles as the entire check budget, and a
    # host answering in just over a second reads as dead. /readyz here is a
    # memory read, so 3s of tolerance costs nothing; a host that cannot answer a
    # memory read in 3s is genuinely wedged.
    #
    # This value plus `inter` bounds how long the router can keep routing to a
    # host that has begun announcing its drain. versiond's MinDrainAnnounce is
    # derived from these two numbers, and its contract test reads this file:
    # raising either without revisiting the floor fails
    # versioned/internal/config TestMinDrainAnnounceCoversTheRouterDetectionWorstCase.
    timeout check 3s

resolvers docker
    nameserver dns 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry   1s
    hold valid 5s
    hold other 5s
    hold refused 5s
    hold nx 5s
    hold timeout 5s

frontend versiond_in
    bind :8080
    maxconn ${MAX_CONNECTIONS}

    # Normalised path: the optional /devshard/ prefix is present only when
    # genesis-proxy is not in front, and must not change routing. Field 2 is
    # then the protocol version and field 4 the escrow id — field 1 is the
    # empty string before the leading slash.
    #
    #   /devshard/v1/sessions/<escrow>/... -> /v1/sessions/<escrow>/...
    #
    # A capture group cannot be used here: HAProxy's converter-argument parser
    # counts parentheses, so any '(' in a regsub argument swallows the comma
    # that separates it from the replacement. field() avoids the question.
    http-request set-var(txn.canonpath) path,regsub(^/devshard/,/)

    # Routing key. Sessions hash by escrow id so one session keeps landing on
    # the instance that holds its hot state; everything else hashes by path so
    # non-session traffic still spreads. Derived here and never taken from a
    # client header: it selects the upstream, so an attacker could otherwise
    # pin themselves to a chosen host.
    http-request set-var(txn.hashkey) var(txn.canonpath)
    http-request set-var(txn.hashkey) var(txn.canonpath),field(4,/) if { var(txn.canonpath) -m reg ^/[^/]+/sessions/[^/]+ }

    http-request set-var(txn.ver) var(txn.canonpath),field(2,/)

    http-request set-header X-Forwarded-Proto %[ssl_fc,iif(https,http)]

    # versiond's own route grammar has versionless endpoints, and their first
    # path segment is not a version. Classifying by "field 2 is non-empty" would
    # refuse /metrics, /stats and the session observability routes.
    #   versioned/internal/proxy/proxy.go: isVersionlessObsPath
    acl versionless_request var(txn.canonpath) -m reg ^/(healthz|readyz|metrics)$|^/stats(/|$)|^/sessions/[^/]+/(diffs|mempool|signatures)$

    ${UNDECLARED_VERSION_GUARD}

    # Legacy pinning wins: those versions own SQLite data on one host.
    use_backend versiond_legacy if { var(txn.ver),map_str(${NON_HA_MAP}) -m found }
    # Then the version's own pool. The map yields a backend name; with no entry
    # there is no match and the request falls through to the host-level pool,
    # which the guard above has already restricted to non-version paths whenever
    # any version is declared.
    use_backend %[var(txn.ver),map_str(${VERSIONS_MAP})]
    default_backend versiond_ha_pool

${POOL_BACKENDS}

backend versiond_legacy
    # Single instance by definition: no sibling can serve the same escrow, so
    # the multi-instance storage guard must not fire here.
    http-request del-header Devshard-Ha

    option httpchk
    http-check send meth GET uri /readyz
    http-check expect status 200

    http-reuse safe
    retry-on conn-failure empty-response 502
    retries 2
    http-request disable-l7-retry if !METH_GET !METH_HEAD !METH_OPTIONS

    http-request replace-path ^/devshard/(.*)$ /\1

    http-response set-header X-Upstream-Addr %[bc_dst]:%[bc_dst_port]
    http-response set-header X-Versiond-Backend versiond_legacy

    server legacy ${VERSIOND_LEGACY_HOST}:${VERSIOND_PORT} check inter 1s fall 1 rise 2 resolvers docker init-addr none init-state fully-down

frontend metrics
    bind 127.0.0.1:8405
    http-request use-service prometheus-exporter if { path /metrics }
    http-request deny
