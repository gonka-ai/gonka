FROM golang:1.22-bookworm AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o /bsruntime ./runtime/
RUN CGO_ENABLED=0 go build -o /scenario-runner ./scenarios/runner/

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl patch git && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /bsruntime /app/bsruntime
COPY --from=builder /scenario-runner /app/scenario-runner

WORKDIR /workspace
ENTRYPOINT ["/app/bsruntime"]
