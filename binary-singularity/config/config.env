# Binary Singularity Bookworm Experiment — Environment Configuration
#
# Copy to .env and adjust as needed.
# All defaults are set for local bookworm stack (no GPU, CPU-only).

# ── Embedder ──
EMBED_PORT=8686

# ── Mock Inference ──
MOCK_NODE_PORT=8080

# ── DAPI ──
DAPI_CACHE__ENABLED=true
DAPI_CACHE__L2_THRESHOLD_BPS=4250
DAPI_CACHE__EMBEDDING_MODEL_VERSION=all-MiniLM-L6-v2
DAPI_CACHE__MAX_AGE_EPOCHS=10

# ── Binary Singularity Runtime ──
BS_STORE_DIR=/data/slots
BS_EMBEDDER_URL=http://embedder:8686
BS_DAPI_URL=http://api:9000
BS_VERBOSE=true

# ── Experiment ──
# 4 participants × 16 scenarios × 4 phases
BS_PARTICIPANTS=4
BS_SCENARIOS=16
BS_PHASES=4

# ── GPU Economics (for metric calculations) ──
GPU_COST_PER_HOUR=2.50
GPU_LATENCY_PER_INFERENCE_SEC=1.28
EPOCH_DURATION_DAYS=7
