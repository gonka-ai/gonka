#!/bin/sh
# Read-only admission probe used by the fleet rollout coordinator.
set -eu

SOCK=${HAPROXY_SOCKET:-/var/run/haproxy/haproxy.sock}
VERSION_MAP=${PROXY_ROUTER_VERSION_MAP:-/etc/haproxy/version-router.map}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

runtime_to_file() {
    command=$1
    target=$2
    if ! printf '%s\n' "$command" | socat stdio "$SOCK" > "$target"; then
        echo "route-status: HAProxy Runtime API command failed: $command" >&2
        return 1
    fi
}

if [ "$#" -ne 2 ]; then
    echo "usage: route-status VERSION|--coarse ADDRESS" >&2
    exit 2
fi

if [ "$1" = --coarse ]; then
    backend=versiond_router_coarse
else
    runtime_to_file "show map $VERSION_MAP" "$tmpdir/map"
    backend=$(awk -v version="$1" \
        '$2 "" == version "" { print $3; found = 1; exit } END { if (!found) exit 3 }' \
        "$tmpdir/map") || {
        status=$?
        [ "$status" -eq 3 ] && exit 3
        exit "$status"
    }
fi

runtime_to_file "show servers state $backend" "$tmpdir/servers"
awk -v address="$2" '
        NR > 2 && $5 == address {
            found = 1
            if ($6 == 2 && $7 == 0) exit 0
            exit 1
        }
        END { if (!found) exit 1 }
    ' "$tmpdir/servers"
