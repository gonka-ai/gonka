#!/bin/sh
# Read-only admission probe used by the fleet rollout coordinator.
set -eu

SOCK=${HAPROXY_SOCKET:-/var/run/haproxy/haproxy.sock}
VERSION_MAP=${PROXY_ROUTER_VERSION_MAP:-/etc/haproxy/version-router.map}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

runtime_to_file() {
    command=$1
    target=$2
    if ! printf '%s\n' "$command" | socat stdio "$SOCK" > "$target"; then
        echo "route-status: HAProxy Runtime API command failed: $command" >&2
        return 1
    fi
}

if [ "$#" -ne 2 ]; then
    echo "usage: route-status VERSION|--coarse ADDRESS" >&2
    exit 2
fi

if [ "$1" = --coarse ]; then
    backend=versiond_router_coarse
else
    runtime_to_file "show map $VERSION_MAP" "$tmpdir/map"
    if ! awk '
            NF && ($1 !~ /^0x[[:xdigit:]]+$/ || NF < 3) { exit 1 }
        ' "$tmpdir/map"; then
        echo "route-status: HAProxy Runtime API returned invalid show map output" >&2
        exit 1
    fi
    backend=$(awk -v version="$1" \
        '$2 "" == version "" { print $3; found = 1; exit } END { if (!found) exit 3 }' \
        "$tmpdir/map") || {
        status=$?
        [ "$status" -eq 3 ] && exit 3
        exit "$status"
    }
fi

runtime_to_file "show servers state $backend" "$tmpdir/servers"
server=$(awk -v address="$2" '
        $1 == "#" {
            # The leading '#' is a header marker, not a data column.
            for (i = 2; i <= NF; i++) column[$i] = i - 1
            header = 1
            next
        }
        header && column["srv_addr"] && column["srv_name"] && \
                $column["srv_addr"] == address {
            print $column["srv_name"]
            found = 1
            exit
        }
        END {
            if (!header || !column["srv_addr"] || !column["srv_name"]) exit 2
            if (!found) exit 1
        }
    ' "$tmpdir/servers") || {
        status=$?
        if [ "$status" -eq 2 ]; then
            echo "route-status: HAProxy Runtime API returned invalid show servers state output" >&2
        fi
        exit 1
    }

# Administrative state from `show servers state` can retain DNS/runtime flags
# after a dynamic slot is enabled. `show stat` is the serving authority: an UP
# status means HAProxy currently admits the server into the backend.
runtime_to_file "show stat" "$tmpdir/stats"
if ! grep -q '^# pxname,svname,' "$tmpdir/stats"; then
    echo "route-status: HAProxy Runtime API returned invalid show stat output" >&2
    exit 1
fi
if ! awk -F, -v backend="$backend" -v server="$server" '
        $1 == backend && $2 == server {
            found = 1
            if ($18 ~ /^UP/) exit 0
            exit 1
        }
        END { if (!found) exit 1 }
    ' "$tmpdir/stats"; then
    exit 1
fi

# Peer RPC is the _rpc twin of this version backend. Its state does not
# gate admission: while the twin is DOWN (a router generation without the
# :8081 peer-RPC listen, or no child answering peer-rpc-ok yet) the proxy
# sends this version's peer RPC to the JSON backend over HTTP/1.1, the one
# admitted above. The twin's state is reported for the operator.
rpc_backend="${backend}_rpc"
awk -F, -v backend="$rpc_backend" -v server="$server" '
        $1 == backend && $2 == server {
            print "route-status: peer RPC twin " backend "/" $2 " is " $18 \
                ($18 ~ /^UP/ ? "" : " (peer RPC takes the HTTP/1.1 path)") > "/dev/stderr"
        }
    ' "$tmpdir/stats"
exit 0
