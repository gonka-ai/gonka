# Host-local ingress and HA pool distributor.
#
# Public traffic first crosses the existing nginx policy workers in TCP mode,
# preserving TLS, CORS, rate limits, rewrites and the on-chain route contract.
# Those workers send /devshard back to the internal HTTP frontend:
#   :18081 -> versiond-router fleet -> versiond
# Edge-api keeps its existing nginx routing path in this release.
#
# The tier has no shared state. DNS is membership, active checks are availability,
# and dapi's governance catalog supplies protocol names. Each process projects
# additions into its own pre-rendered backends, while every versiond-router
# independently computes the same escrow placement.

global
    log stdout format raw local0 info
    stats socket /var/run/haproxy/haproxy.sock mode 660 level operator
    stats socket /var/run/haproxy/reconciler.sock mode 600 level admin
    stats timeout 30s

defaults
    log global
    mode http
    option dontlognull
    timeout connect ${CONNECT_TIMEOUT_SECONDS}s
    timeout client ${STREAM_IDLE_SECONDS}s
    timeout server ${STREAM_IDLE_SECONDS}s
    timeout http-request ${CONNECT_TIMEOUT_SECONDS}s
    timeout http-keep-alive 10s
    timeout check 3s

resolvers docker
    nameserver dns ${DNS_RESOLVER}
    accepted_payload_size 8192
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 5s
    hold other 5s
    hold refused 5s
    hold nx 5s
    hold timeout 5s

# TCP keeps the mature nginx policy contract byte-for-byte, including TLS and
# HTTP/2. PROXY v2 restores the real client address at the private worker.
frontend public_http
    mode tcp
    option tcplog
    bind :80
    ${PUBLIC_PROXY_ACL}
    ${PUBLIC_PROXY_EXPECT}
    timeout client ${PUBLIC_IDLE_SECONDS}s
    default_backend policy_http

frontend public_https
    mode tcp
    option tcplog
    bind :443
    ${PUBLIC_PROXY_ACL}
    ${PUBLIC_PROXY_EXPECT}
    timeout client ${PUBLIC_IDLE_SECONDS}s
    default_backend policy_https

backend policy_http
    mode tcp
    balance source
    hash-type consistent
    option redispatch
    retries 2
    timeout server ${PUBLIC_IDLE_SECONDS}s
    option tcp-check
    # Exercise the production listener end to end: the same connection carries
    # the production PROXY v2 preamble, request and application-ready response.
    # HAProxy derives v2 from the server's send-proxy-v2 setting; the check
    # directive itself uses the generic send-proxy keyword.
    tcp-check connect port 80 send-proxy
    tcp-check send-binary 474554202f6865616c746820485454502f312e310d0a486f73743a20706f6c6963792d6865616c74680d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a
    tcp-check expect rstring ^HTTP/1\.[01][[:space:]]+200
    server-template policy ${POLICY_POOL_SLOTS} ${POLICY_POOL_HOST}:80 check inter 1s fall 2 rise 2 resolvers docker init-addr none init-state fully-down hash-key addr send-proxy-v2

backend policy_https
    mode tcp
    balance source
    hash-type consistent
    option redispatch
    retries 2
    timeout server ${PUBLIC_IDLE_SECONDS}s
    option tcp-check
    tcp-check connect port 443 ssl send-proxy
    tcp-check send-binary 474554202f6865616c746820485454502f312e310d0a486f73743a20706f6c6963792d6865616c74680d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a
    tcp-check expect rstring ^HTTP/1\.[01][[:space:]]+200
    server-template policy ${POLICY_POOL_SLOTS} ${POLICY_POOL_HOST}:443 check inter 1s fall 2 rise 2 resolvers docker init-addr none init-state fully-down hash-key addr send-proxy-v2 verify none

frontend versiond_router_in
    option httplog
    bind ${POLICY_BIND_ADDRESS}:${VERSIOND_FRONTEND_PORT}
    maxconn ${MAX_CONNECTIONS}

    http-request set-var(txn.canonpath) path,regsub(^/devshard/,/)
    http-request set-var(txn.hashkey) var(txn.canonpath)
    http-request set-var(txn.hashkey) var(txn.canonpath),field(4,/) if { var(txn.canonpath) -m reg ^/[^/]+/sessions/[^/]+ }
    http-request set-var(txn.hashkey) var(txn.canonpath),field(3,/) if { var(txn.canonpath) -m reg ^/sessions/[^/]+/(diffs|mempool|signatures)$ }
    http-request set-var(txn.hashkey) var(txn.canonpath),field(4,/) if { var(txn.canonpath) -m reg ^/stats/shards/[^/]+$ }
    http-request set-var(txn.ver) var(txn.canonpath),field(2,/)
    # The policy worker has already derived these from its trusted PROXY peer.
    # Preserve them; src here is only the policy container.

    acl versionless_request var(txn.canonpath) -m reg ^/(healthz|readyz|metrics)$|^/stats(/|$)|^/sessions/[^/]+/(diffs|mempool|signatures)$
    ${UNDECLARED_VERSION_GUARD}
    use_backend %[var(txn.ver),map_str(${VERSION_BACKEND_MAP})] if !versionless_request { var(txn.ver),map_str(${VERSION_BACKEND_MAP}) -m found }
    default_backend versiond_router_coarse

${VERSIOND_ROUTER_BACKENDS}

${CATALOG_PROXY_CONFIG}

frontend admin
    option httplog
    bind 127.0.0.1:${ADMIN_PORT}
    http-request return status 200 content-type text/plain string "live\n" if { path /livez }
    http-request set-var(txn.ready_ver) url_param(version),url_dec(0) if { path /readyz } { url_param(version) -m found }
${ADMIN_READY_RULES}
    ${DYNAMIC_READY_GUARD}
    default_backend admin_not_found

backend admin_not_found
    http-request return status 404 content-type text/plain string "not found\n"

frontend metrics
    option httplog
    bind 127.0.0.1:8405
${METRICS_NETWORK_BIND}
    http-request use-service prometheus-exporter if { path /metrics }
    http-request deny
