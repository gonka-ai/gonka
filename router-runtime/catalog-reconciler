#!/bin/sh

# Monotonically publishes accepted version names into pre-rendered HAProxy
# backends. Unpublished staging assignments may be reclaimed when governance
# withdraws or corrects a candidate before it reaches the activation reserve.
# The source keeps its existing {"versions":[...]} contract. The data plane
# remains fail-closed: a version is published in
# the request map only after its slot has been assigned and its servers have
# been enabled for active health checks.
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1090,SC1091
. "$script_dir/version-contract"

component=${ROUTING_CATALOG_COMPONENT:-router}
catalog_url=${ROUTING_CATALOG_URL:-}
poll_seconds=${ROUTING_CATALOG_POLL_SECONDS:-5}
fetch_timeout=${ROUTING_CATALOG_FETCH_TIMEOUT_SECONDS:-3}
runtime_timeout=${ROUTING_CATALOG_RUNTIME_TIMEOUT_SECONDS:-2}
runtime_socket=${ROUTING_CATALOG_RUNTIME_SOCKET:-/var/run/haproxy/reconciler.sock}
projection_map=${ROUTING_CATALOG_PROJECTION_MAP:?ROUTING_CATALOG_PROJECTION_MAP is required}
slot_map=${ROUTING_CATALOG_SLOT_MAP:?ROUTING_CATALOG_SLOT_MAP is required}
backend_prefix=${ROUTING_CATALOG_BACKEND_PREFIX:?ROUTING_CATALOG_BACKEND_PREFIX is required}
backend_capacity=${ROUTING_CATALOG_BACKEND_CAPACITY:?ROUTING_CATALOG_BACKEND_CAPACITY is required}
server_prefix=${ROUTING_CATALOG_SERVER_PREFIX:?ROUTING_CATALOG_SERVER_PREFIX is required}
server_capacity=${ROUTING_CATALOG_SERVER_CAPACITY:?ROUTING_CATALOG_SERVER_CAPACITY is required}
activation_min_ready=${ROUTING_CATALOG_ACTIVATION_MIN_READY:-2}
excluded_versions=${ROUTING_CATALOG_EXCLUDE:-}
cache_file=${ROUTING_CATALOG_CACHE_FILE:-}
cache_bin=${ROUTING_CATALOG_CACHE_BIN:-/usr/local/lib/router-runtime/catalog-cache}
cache_max_age=${ROUTING_CATALOG_CACHE_MAX_AGE_SECONDS:-86400}
status_file=${ROUTING_CATALOG_STATUS_FILE:-}

log() {
    printf '%s\n' "$component: $*" >&2
}

for value in "$poll_seconds" "$fetch_timeout" "$runtime_timeout" "$backend_capacity" \
    "$server_capacity" "$activation_min_ready" "$cache_max_age"; do
    case "$value" in
        '' | *[!0-9]* | 0)
            log "catalog timing, cache age, and capacity values must be positive integers"
            exit 1
            ;;
    esac
done
[ "$activation_min_ready" -le "$server_capacity" ] || {
    log "catalog activation reserve exceeds backend server capacity"
    exit 1
}
cache_refresh_seconds=$((cache_max_age / 2))
[ "$cache_refresh_seconds" -gt 0 ] || cache_refresh_seconds=1

case "$catalog_url" in
    '') exit 0 ;;
    http://* | https://*) ;;
    *)
        log "ROUTING_CATALOG_URL must use http or https"
        exit 1
        ;;
esac

command -v jq >/dev/null 2>&1 || {
    log "jq is required for the routing catalog"
    exit 1
}
command -v socat >/dev/null 2>&1 || {
    log "socat is required for the HAProxy Runtime API"
    exit 1
}
tmpdir=$(mktemp -d)
cleanup() {
    rm -rf "$tmpdir"
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
excluded_names=$tmpdir/excluded.names
printf '%s\n' "$excluded_versions" | tr ',;[:space:]' '\n' | \
    sed '/^$/d' | LC_ALL=C sort -u > "$excluded_names"

project_names() {
    source=$1 destination=$2
    awk '
        FILENAME == ARGV[1] { excluded[$0] = 1; next }
        !($0 in excluded)
    ' "$excluded_names" "$source" > "$destination"
}

last_state=starting
last_names=$tmpdir/last.names
: > "$last_names"
last_persisted_at=0
last_used=$(awk '$2 != "__unassigned__" { used++ } END { print used + 0 }' \
    "$slot_map")

if [ -n "$cache_file" ] && [ -f "$cache_file" ]; then
    [ -x "$cache_bin" ] || {
        log "catalog cache exists but $cache_bin is unavailable"
        exit 1
    }
    cache_status=0
    "$cache_bin" read "$cache_file" "$cache_max_age" > "$last_names" || cache_status=$?
    if [ "$cache_status" -eq 0 ]; then
        last_persisted_at=$(jq -er '.fetched_at_unix' "$cache_file") || cache_status=$?
        if [ "$cache_status" -eq 0 ]; then
            project_names "$last_names" "$tmpdir/cache.projected.names"
            mv "$tmpdir/cache.projected.names" "$last_names"
        fi
    fi
    if [ "$cache_status" -ne 0 ]; then
        if [ "$cache_status" -eq 2 ]; then
            log "ignoring stale persistent catalog cache; waiting for a fresh catalog"
        else
            log "ignoring invalid persistent catalog cache; waiting for a fresh catalog"
        fi
        : > "$last_names"
        last_persisted_at=0
    fi
fi

set_state() {
    state=$1 detail=$2
    if [ "$state" != "$last_state" ]; then
        case "$state" in
            ready)
                [ "$last_state" = starting ] || log "catalog reconciliation recovered"
                ;;
            *) log "catalog reconciliation degraded: $detail" ;;
        esac
        last_state=$state
    fi
    [ -n "$status_file" ] || return 0
    directory=$(dirname -- "$status_file")
    [ -d "$directory" ] || return 0
    status_tmp=$(mktemp "$directory/.catalog-status.XXXXXX") || return 0
    if jq -n \
        --arg state "$state" \
        --arg detail "$detail" \
        --argjson observed_at_unix "$(date +%s)" \
        --argjson used "$last_used" \
        --argjson capacity "$backend_capacity" \
        '{schema: 1, state: $state, detail: $detail,
          observed_at_unix: $observed_at_unix,
          dynamic_slots_used: $used, dynamic_slots_capacity: $capacity}' \
        > "$status_tmp"; then
        chmod 600 "$status_tmp"
        mv -f "$status_tmp" "$status_file"
    else
        rm -f "$status_tmp"
    fi
}

runtime() {
    response=$(printf '%s;show info\n' "$1" | \
        socat -t "$runtime_timeout" -T "$runtime_timeout" \
            - "UNIX-CONNECT:$runtime_socket") || return 1

    # A successful mutation has no payload, which otherwise looks identical to
    # a half-open socket timing out. The appended show-info command proves that
    # HAProxy processed the exchange; hide its response from callers.
    printf '%s\n' "$response" | awk '
        /^Name: HAProxy$/ { answered = 1; exit }
        { lines[++count] = $0 }
        END {
            if (!answered) exit 1
            while (count > 0 && lines[count] == "") count--
            for (i = 1; i <= count; i++) print lines[i]
        }
    '
}

# HAProxy's Runtime API treats a semicolon followed by whitespace as a command
# separator. Version names cannot contain whitespace or backslashes, and an
# escaped semicolon preserves the remaining basename characters literally.
runtime_key() {
    printf '%s' "$1" | sed 's/;/\\;/g'
}

validate_version() {
	router_version_is_valid "$1"
}

fetch_catalog() {
    body=$tmpdir/catalog.json
    raw_names=$tmpdir/catalog.raw.names
    names=$tmpdir/catalog.names
    if ! wget -q -T "$fetch_timeout" -O "$body" "$catalog_url"; then
        return 1
    fi
    if ! jq -r '
        if type != "object" then error("catalog is not an object") else . end
        |
        .versions as $versions
        | if ($versions | type) != "array" then error("versions is not an array") else $versions end
        | .[]
        | if (.name | type) != "string" then error("version name is not a string") else .name end
    ' "$body" > "$raw_names"; then
        return 1
    fi
    if duplicate=$(router_first_duplicate "$raw_names") && [ -n "$duplicate" ]; then
        return 1
    fi
    while IFS= read -r version; do
        validate_version "$version" || return 1
    done < "$raw_names"
    LC_ALL=C sort -u "$raw_names" -o "$raw_names"
    project_names "$raw_names" "$names"
}

validate_catalog_progression() {
    removed=$(awk '
        FILENAME == ARGV[1] { current[$0] = 1; next }
        !($0 in current) { print; exit }
    ' "$tmpdir/catalog.names" "$last_names")
    [ -z "$removed" ] || return 1

    catalog_changed=1
    if cmp -s "$last_names" "$tmpdir/catalog.names"; then
        catalog_changed=0
    fi
}

persist_catalog() {
    [ -n "$cache_file" ] || return 0
    [ -x "$cache_bin" ] || return 1
    now=$(date +%s)
    if [ "$catalog_changed" -eq 0 ] && [ "$last_persisted_at" -gt 0 ] && \
        [ $((now - last_persisted_at)) -lt "$cache_refresh_seconds" ]; then
        return 0
    fi
    "$cache_bin" write "$tmpdir/catalog.names" "$cache_file" || return 1
    last_persisted_at=$now
}

accept_catalog() {
    cp "$tmpdir/catalog.names" "$last_names"
}

map_snapshot() {
    runtime "show map $1" 2>/dev/null
}

remember_slot_usage() {
    last_used=$(printf '%s\n' "$slot_state" | awk -v prefix="$backend_prefix" '
        index($2, prefix) == 1 && $3 != "__unassigned__" { used++ }
        END { print used + 0 }
    ')
}

mapped_backend() {
    version=$1
    awk -v version="$version" '$2 "" == version "" { print $3; exit }'
}

slot_for_encoded_version() {
    encoded=$1
    awk -v encoded="$encoded" -v prefix="$backend_prefix" '
        index($2, prefix) == 1 && $3 "" == encoded "" { print $2; exit }
    '
}

assign_slot() {
    backend=$1 encoded=$2
    escaped_backend=$(runtime_key "$backend")
    escaped_encoded=$(runtime_key "$encoded")
    response=$(runtime "set map $slot_map $escaped_backend $escaped_encoded" 2>&1) || return 1
    [ -z "$response" ] || return 1
}

enable_slot() {
    backend=$1
    index=1
    while [ "$index" -le "$server_capacity" ]; do
        response=$(runtime "enable server $backend/$server_prefix$index" 2>&1) || return 1
        [ -z "$response" ] || return 1
        index=$((index + 1))
    done
}

disable_slot() {
    backend=$1
    index=1
    while [ "$index" -le "$server_capacity" ]; do
        response=$(runtime "disable server $backend/$server_prefix$index" 2>&1) || return 1
        [ -z "$response" ] || return 1
        index=$((index + 1))
    done
}

reclaim_withdrawn_pending_slots() {
    printf '%s\n' "$slot_state" | awk -v prefix="$backend_prefix" '
        index($2, prefix) == 1 && $3 != "__unassigned__" { print $2, $3 }
    ' > "$tmpdir/assigned.slots"

    while read -r backend encoded; do
        [ -n "$backend" ] || continue
        if awk -v backend="$backend" '$3 == backend { found = 1 } END { exit !found }' \
            "$tmpdir/projection.current"; then
            continue
        fi
        if grep -Fqx "$encoded" "$tmpdir/catalog.encoded"; then
            continue
        fi
        disable_slot "$backend" || return 1
        assign_slot "$backend" __unassigned__ || return 1
    done < "$tmpdir/assigned.slots"

    slot_state=$(map_snapshot "$slot_map") || return 1
    remember_slot_usage
}

ready_server_count() {
    backend=$1 stats=$2
    awk -F, -v backend="$backend" '
        $1 == backend && $2 != "BACKEND" && $18 ~ /^UP/ { ready++ }
        END { print ready + 0 }
    ' "$stats"
}

publish_projection() {
	map=$projection_map
	if ! awk '$4 == 1 { found = 1 } END { exit !found }' \
		"$tmpdir/projection.plan"; then
		return 0
	fi

	while read -r version _ backend publish_version_entry; do
		[ "$publish_version_entry" -eq 1 ] || continue
		escaped_backend=$(runtime_key "$backend")
		escaped_key=$(runtime_key "$version")
		# Verify the complete projection below. That also resolves an ambiguous
		# socket failure after HAProxy applied a mutation.
		runtime "add map $map $escaped_key $escaped_backend" >/dev/null 2>&1 || true
	done < "$tmpdir/projection.plan"

	projection_state=$(map_snapshot "$map") || return 1
	while read -r version _ backend publish_version_entry; do
		[ "$publish_version_entry" -eq 1 ] || continue
		printf '%s\n' "$projection_state" | awk \
			-v key="$version" -v expected="$backend" '
				$2 "" == key "" && $3 "" == expected "" { found = 1 }
				END { exit !found }
			' || return 1
	done < "$tmpdir/projection.plan"
}

publish_catalog() {
	# Each ready version is one monotonic map addition. The same canonical key
	# drives both data routing and parent admission, so no batch transaction or
	# second readiness mutation is needed.
	publish_projection || return 1
	while read -r version _ _ publish_version_entry; do
		[ "$publish_version_entry" -eq 1 ] || continue
		log "declared governance version '$version'"
	done < "$tmpdir/projection.plan"
}

prepare_catalog() {
	projection_state=$(map_snapshot "$projection_map") || return 1
	version_state=$projection_state
	slot_state=$(map_snapshot "$slot_map") || return 1
	remember_slot_usage
	printf '%s\n' "$projection_state" > "$tmpdir/projection.current"
	: > "$tmpdir/catalog.encoded"
	while IFS= read -r version; do
		[ -n "$version" ] || continue
		router_urlencode "$version"
		printf '\n'
	done < "$tmpdir/catalog.names" > "$tmpdir/catalog.encoded"
	reclaim_withdrawn_pending_slots || return 1

	# Build the complete plan before changing HAProxy. catalog.names is already
	# filtered to dynamic names, so lookup and encoding have one authoritative
	# implementation instead of separate capacity and assignment passes.
	: > "$tmpdir/projection.plan"
	while IFS= read -r version; do
		[ -n "$version" ] || continue
		encoded=$(router_urlencode "$version")
		backend=$(printf '%s\n' "$version_state" | mapped_backend "$version")
		publish_version_entry=0
		if [ -z "$backend" ]; then
			backend=$(printf '%s\n' "$slot_state" | slot_for_encoded_version "$encoded")
			[ -n "$backend" ] || backend=__new__
			publish_version_entry=1
		fi
		printf '%s %s %s %s\n' "$version" "$encoded" "$backend" \
			"$publish_version_entry" \
			>> "$tmpdir/projection.plan"
	done < "$tmpdir/catalog.names"

	printf '%s\n' "$slot_state" | awk -v prefix="$backend_prefix" '
		index($2, prefix) == 1 && $3 == "__unassigned__" { print $2 }
	' > "$tmpdir/free.slots"
	free_capacity=$(wc -l < "$tmpdir/free.slots")
	required_capacity=$(awk '$3 == "__new__" { required++ } END { print required + 0 }' \
		"$tmpdir/projection.plan")
	if [ "$required_capacity" -gt "$free_capacity" ]; then
		capacity_missing=$(awk -v available="$free_capacity" '
			$3 == "__new__" && ++required > available { print $1; exit }
		' "$tmpdir/projection.plan")
		return 2
	fi

	: > "$tmpdir/slot.assignments"
	: > "$tmpdir/projection.assigned"
	next_free=1
	while read -r version encoded backend publish_version_entry; do
		if [ "$backend" = __new__ ]; then
			backend=$(sed -n "${next_free}p" "$tmpdir/free.slots")
			next_free=$((next_free + 1))
			assign_slot "$backend" "$encoded" || return 1
			printf '%s %s\n' "$backend" "$encoded" >> "$tmpdir/slot.assignments"
		fi
		printf '%s %s %s %s\n' "$version" "$encoded" "$backend" \
			"$publish_version_entry" >> "$tmpdir/projection.assigned"
	done < "$tmpdir/projection.plan"
	mv "$tmpdir/projection.assigned" "$tmpdir/projection.plan"

	if [ -s "$tmpdir/slot.assignments" ]; then
		slot_state=$(map_snapshot "$slot_map") || return 1
		remember_slot_usage
		while read -r backend encoded; do
			printf '%s\n' "$slot_state" | awk \
				-v key="$backend" -v expected="$encoded" '
					$2 "" == key "" && $3 "" == expected "" { found = 1 }
					END { exit !found }
				' || return 1
		done < "$tmpdir/slot.assignments"
	fi

	while read -r _ _ backend publish_version_entry; do
		[ "$publish_version_entry" -eq 1 ] || continue
		enable_slot "$backend" || return 1
	done < "$tmpdir/projection.plan"

	# No route in this projection becomes visible until every new backend has the
	# configured reserve. Slot assignment and checks are staging mutations only.
	runtime "show stat" > "$tmpdir/runtime.stats" 2>/dev/null || return 1
	while read -r version _ backend publish_version_entry; do
		[ "$publish_version_entry" -eq 1 ] || continue
		ready=$(ready_server_count "$backend" "$tmpdir/runtime.stats") || return 1
		if [ "$ready" -lt "$activation_min_ready" ]; then
			activation_version=$version
			activation_ready=$ready
			return 3
		fi
	done < "$tmpdir/projection.plan"
}

while :; do
    if [ ! -S "$runtime_socket" ]; then
        set_state runtime-unavailable "HAProxy Runtime API is not ready"
    elif ! fetch_catalog; then
        set_state fetch-error "cannot fetch or validate $catalog_url"
    elif ! validate_catalog_progression; then
        set_state projection-error \
            "catalog removed previously projected version '$removed'"
    else
		reconcile_status=0
		prepare_catalog || reconcile_status=$?
        if [ "$reconcile_status" -eq 2 ]; then
            set_state capacity-exhausted \
                "no free backend slot for governance version '$capacity_missing'"
        elif [ "$reconcile_status" -eq 3 ]; then
            set_state activation-pending \
				"governance version '$activation_version' has $activation_ready/$activation_min_ready ready backends"
		elif [ "$reconcile_status" -ne 0 ]; then
			set_state runtime-error "HAProxy rejected a catalog projection"
		elif ! persist_catalog; then
			set_state cache-error "cannot persist the last valid catalog snapshot"
		else
			# The cache is the durable commit point. A process crash after this point
			# restores the whole projection before the catalog endpoint is available.
			accept_catalog
			if publish_catalog; then
				set_state ready "catalog and runtime maps are current"
			else
				set_state runtime-error "HAProxy rejected an accepted catalog projection"
			fi
		fi
    fi
    sleep "$poll_seconds"
done
